# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ZyraVision — Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

APP_NAME=ZyraVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_PORT=8000

# ─── Locale ────────────────────────────────────────────────
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# ─── Database (PostgreSQL) ─────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=zyravision
DB_USERNAME=zyravision
DB_PASSWORD=secret

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ─── Mail ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contato@ziravision.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite ──────────────────────────────────────────────────
VITE_PORT=5173
VITE_APP_NAME="${APP_NAME}"

# ─── MeiliSearch ───────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
MEILISEARCH_PORT=7700

# ─── Contact Info ──────────────────────────────────────────
ZYRA_WHATSAPP=5564996257284
ZYRA_EMAIL=contato@ziravision.com.br

# ─── Broadcasting (Reverb / WebSocket) ────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=zyravision
REVERB_APP_KEY=zyravision-reverb-key
REVERB_APP_SECRET=zyravision-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── MediaMTX (Streaming Server) ──────────────────────────
MEDIAMTX_HOST=mediamtx
MEDIAMTX_API_PORT=9997
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_TIMEOUT=10
HLS_BASE_URL=/hls
MAX_CONCURRENT_STREAMS=50
SNAPSHOT_INTERVAL_MINUTES=5

# ─── Auto-Recovery de Streams (Self-Healing) ────────────────
# O sistema recupera cameras automaticamente em 3 fases:
#   Fase 1 (Soft): Re-registra o path ou aguarda o MediaMTX reconectar (backoff 30s-120s)
#   Fase 2 (Hard Reset): Remove e readiciona o path no MediaMTX (equivale ao "Forcar Reset" manual)
#   Fase 3 (Manutencao): Hard resets periodicos indefinidamente — o sistema NUNCA desiste
#
# Quantas tentativas de recuperacao suave (Fase 1) antes de escalar para hard reset
STREAM_SOFT_MAX_ATTEMPTS=5
# Quantas tentativas suaves devem falhar antes de iniciar o hard reset (Fase 2)
STREAM_SOFT_BEFORE_HARD_RESET=3
# Quantos hard resets (Fase 2) executar antes de entrar em modo manutencao (Fase 3)
STREAM_HARD_MAX_ATTEMPTS=3
# Intervalo em segundos entre tentativas no modo manutencao (Fase 3, padrao: 300 = 5 min)
STREAM_MAINTENANCE_INTERVAL=300
# Quantas verificacoes consecutivas (a cada 30s) o stream pode ficar "nao pronto"
# antes de ser marcado como erro e iniciar a recuperacao (padrao: 6 = ~3 min)
STREAM_NOT_READY_CHECKS=6



# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Worker Scaling (Fase 8) — Escalabilidade e Processamento
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Ajuste conforme o numero de cameras e carga do sistema:
#
# | Cenario    | Cameras | TRANSCODER | QUEUE | Nginx | RAM   | vCPUs |
# |------------|---------|------------|-------|-------|-------|-------|
# | Pequeno    | 1-10    | 0-1        | 1     | 1     | 4-8GB | 2-4   |
# | Medio      | 10-30   | 1-2        | 2     | 1-2   | 8-16  | 4-8   |
# | Grande     | 30-50   | 2-4        | 2-4   | 2-3   | 16-32 | 8-16  |
# | Enterprise | 50-100+ | 4-8        | 4-8   | 3-5   | 32-64 | 16-32 |
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── FFmpeg Transcoder Workers ─────────────────────────────
# Replicas do container transcoder (0 = desativado, cameras usam MediaMTX nativo)
TRANSCODER_REPLICAS=1
# Max cameras simultaneas por worker transcoder
FFMPEG_MAX_CONCURRENT=10
# Preset h264: ultrafast|superfast|veryfast|fast|medium
FFMPEG_H264_PRESET=fast
# Nivel de log FFmpeg: quiet|panic|fatal|error|warning|info|verbose|debug
FFMPEG_LOG_LEVEL=warning

# ─── Queue Workers (Horizon) ──────────────────────────────
# Replicas do container queue (cada replica roda Horizon com todos os supervisors)
QUEUE_REPLICAS=1

# ─── Web/Nginx Workers ────────────────────────────────────
# NOTA: Para WEB_REPLICAS > 1, eh necessario configurar um load balancer
# (traefik, haproxy) na frente e remover container_name do servico web.
# Com WEB_REPLICAS=1 (padrao), o nginx ja usa todos os CPUs do container.
WEB_REPLICAS=1

# ─── Scheduler ─────────────────────────────────────────────
SCHEDULER_ENABLED=true

# ─── Demo Mode ─────────────────────────────────────────────
DEMO_MODE=false
DEMO_RESET_INTERVAL=24
